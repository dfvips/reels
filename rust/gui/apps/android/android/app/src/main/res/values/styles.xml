<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GpuiStartingTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/GpuiTheme</item>
    </style>

    <!--
      Native text selection must use the device vendor's system ActionMode.
      Theme.Material forces the legacy Material floating toolbar even on
      Android 15. DeviceDefault inherits the OEM selection menu, magnifier,
      overflow behaviour and floating-toolbar styling used by system apps.
    -->
    <style name="GpuiTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:colorAccent">#3B82F6</item>
        <item name="android:colorControlActivated">#3B82F6</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:statusBarColor">#FFFFFF</item>
    </style>
</resources>
